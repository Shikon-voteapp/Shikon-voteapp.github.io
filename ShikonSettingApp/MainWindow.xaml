<Window x:Class="ShikonSettingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShikonSettingApp"
        mc:Ignorable="d"
        Title="VoteApp Editor" Height="760" Width="1080"
        FontFamily="Yu Gothic UI" FontSize="14">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="フォルダ選択" Command="{Binding SelectFolderCommand}"/>
                <Button Content="保存" Command="{Binding SaveCommand}" Click="Button_Click"/>
            </ToolBar>
        </ToolBarTray>

        <TabControl Margin="6">
            <!-- タブ 1: 団体設定 -->
            <TabItem Header="団体設定">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="団体リスト" Grid.Column="0" Margin="0,0,5,0">
                        <DockPanel Margin="5">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="＋ 団体を追加" Command="{Binding AddGroupCommand}" Padding="10,4" Margin="0,0,8,0"/>
                                <Button Content="－ 選択中の団体を削除" Command="{Binding RemoveGroupCommand}" 
                                        IsEnabled="{Binding SelectedGroup, Converter={StaticResource NullToBoolConverter}}" Padding="10,4"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel VerticalAlignment="Center" Margin="2">
                                            <TextBlock Text="⚠️ 重複" Foreground="#FFE02424" FontWeight="Bold" FontSize="11"
                                                       DockPanel.Dock="Right" VerticalAlignment="Center" Margin="5,0,0,0"
                                                       Visibility="{Binding HasDuplicateId, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </GroupBox>

                    <Grid Grid.Column="1" Margin="5,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5"
                                      Visibility="{Binding SelectedGroup, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Margin="10">
                                <TextBlock Text="ID" FontWeight="Bold"/>
                                <TextBox Text="{Binding SelectedGroup.Id, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
                                <Border Background="#FFFDE8E8" BorderBrush="#FFF05252" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,10"
                                        Visibility="{Binding HasIdWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding IdWarningMessage}" Foreground="#FFE02424" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="団体名 (name)" FontWeight="Bold"/>
                                <TextBox Text="{Binding SelectedGroup.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                <TextBlock Text="グループ名 (groupName)" FontWeight="Bold"/>
                                <TextBox Text="{Binding SelectedGroup.GroupName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                <TextBlock Text="階 (floor)" FontWeight="Bold"/>
                                <TextBox Text="{Binding SelectedGroup.Floor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                <TextBlock Text="説明 (description)" FontWeight="Bold"/>
                                <TextBox Text="{Binding SelectedGroup.Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                <TextBlock Text="画像パス (imagePath)" FontWeight="Bold"/>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="選択..." Command="{Binding SelectImageCommand}"/>
                                    <TextBox Text="{Binding SelectedGroup.ImagePath, Mode=OneWay}" IsReadOnly="True"/>
                                </DockPanel>

                                <TextBlock Text="カテゴリ (categories)" FontWeight="Bold" Margin="0,10,0,5"/>
                                <ItemsControl ItemsSource="{Binding SelectableCategories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="6,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Text="← 左のリストから団体を選択してください" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="Gray"
                                   Visibility="{Binding SelectedGroup, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- タブ 2: 賞の設定 -->
            <TabItem Header="賞の設定">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="賞リスト" Grid.Column="0" Margin="0,0,5,0">
                        <DockPanel Margin="5">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="＋ 賞を追加" Command="{Binding AddVoteCategoryCommand}" Padding="10,4" Margin="0,0,8,0"/>
                                <Button Content="－ 選択中の賞を削除" Command="{Binding RemoveVoteCategoryCommand}" 
                                        IsEnabled="{Binding SelectedVoteCategory, Converter={StaticResource NullToBoolConverter}}" Padding="10,4"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding VoteCategories}" SelectedItem="{Binding SelectedVoteCategory}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel VerticalAlignment="Center" Margin="2">
                                            <TextBlock Text="⚠️ 重複" Foreground="#FFE02424" FontWeight="Bold" FontSize="11"
                                                       DockPanel.Dock="Right" VerticalAlignment="Center" Margin="5,0,0,0"
                                                       Visibility="{Binding HasDuplicateId, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </GroupBox>

                    <Grid Grid.Column="1" Margin="5,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5"
                                      Visibility="{Binding SelectedVoteCategory, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Margin="10" DataContext="{Binding SelectedVoteCategory}">
                                <TextBlock Text="ID" FontWeight="Bold"/>
                                <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
                                <Border Background="#FFFDE8E8" BorderBrush="#FFF05252" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,10"
                                        Visibility="{Binding DataContext.HasVoteCategoryIdWarning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding DataContext.VoteCategoryIdWarningMessage, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#FFE02424" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="賞名 (name)" FontWeight="Bold"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                <TextBlock Text="説明 (description)" FontWeight="Bold"/>
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                <TextBlock Text="補足・ヘルプ文 (shortHelpText)" FontWeight="Bold"/>
                                <TextBox Text="{Binding ShortHelpText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                                <TextBlock Text="ヘルプURL・パス (helpUrl)" FontWeight="Bold"/>
                                <TextBox Text="{Binding HelpUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                <CheckBox IsChecked="{Binding CanSkip}" Content="この賞の投票をスキップ可能にする (canSkip)" FontWeight="Bold" Margin="0,5,0,15"/>

                                <TextBlock Text="対象カテゴリ (未選択時はすべての団体が対象)" FontWeight="Bold" Margin="0,0,0,5"/>
                                <ItemsControl ItemsSource="{Binding DataContext.SelectableVoteCategoryTargets, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="6,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Text="← 左のリストから賞を選択してください" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="Gray"
                                   Visibility="{Binding SelectedVoteCategory, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- タブ 3: 投票期間設定 -->
            <TabItem Header="投票期間設定">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" DataContext="{Binding Config}" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="投票開始日時" FontWeight="Bold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <DatePicker SelectedDate="{Binding StartDateOnly}" Width="150" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Source={x:Static local:MainViewModel.Hours}}"
                                      SelectedItem="{Binding StartHour}"
                                      ItemStringFormat="{}{0:D2}"
                                      Width="65" Margin="10,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="時" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding Source={x:Static local:MainViewModel.Minutes}}"
                                      SelectedItem="{Binding StartMinute}"
                                      ItemStringFormat="{}{0:D2}"
                                      Width="65" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="分" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="投票終了日時" FontWeight="Bold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <DatePicker SelectedDate="{Binding EndDateOnly}" Width="150" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Source={x:Static local:MainViewModel.Hours}}"
                                      SelectedItem="{Binding EndHour}"
                                      ItemStringFormat="{}{0:D2}"
                                      Width="65" Margin="10,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="時" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding Source={x:Static local:MainViewModel.Minutes}}"
                                      SelectedItem="{Binding EndMinute}"
                                      ItemStringFormat="{}{0:D2}"
                                      Width="65" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="分" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Separator Margin="0,0,0,15"/>

                        <CheckBox IsChecked="{Binding MaintenanceEnabled}" Content="定期メンテナンスを有効にする" Margin="0,0,0,15" FontWeight="Bold"/>

                        <StackPanel IsEnabled="{Binding MaintenanceEnabled}" Margin="15,0,0,0">
                            <TextBlock Text="メンテナンス開始時刻" FontWeight="Bold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <ComboBox ItemsSource="{Binding Source={x:Static local:MainViewModel.Hours}}"
                                          SelectedItem="{Binding MaintenanceStartHour}"
                                          ItemStringFormat="{}{0:D2}"
                                          Width="65" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="時" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding Source={x:Static local:MainViewModel.Minutes}}"
                                          SelectedItem="{Binding MaintenanceStartMinute}"
                                          ItemStringFormat="{}{0:D2}"
                                          Width="65" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="分" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="メンテナンス終了時刻" FontWeight="Bold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <ComboBox ItemsSource="{Binding Source={x:Static local:MainViewModel.Hours}}"
                                          SelectedItem="{Binding MaintenanceEndHour}"
                                          ItemStringFormat="{}{0:D2}"
                                          Width="65" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="時" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding Source={x:Static local:MainViewModel.Minutes}}"
                                          SelectedItem="{Binding MaintenanceEndMinute}"
                                          ItemStringFormat="{}{0:D2}"
                                          Width="65" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="分" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
{
  "rules": {
    ".read": false,
    ".write": false,
    "votes": {
      ".read": "auth != null",
      ".write": "auth != null && !newData.exists()",
      "$uuid": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['uuid','selections','timestamp']) && newData.child('uuid').val() == $uuid"
      }
    }
  }
}